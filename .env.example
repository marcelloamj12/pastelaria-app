# Copie este arquivo para ".env" na raiz do projeto Expo e preencha.
#
# Onde achar: Supabase > cardapio-miltao > Settings > API Keys
#   URL   -> Settings > Data API > Project URL
#   CHAVE -> aba "Publishable and secret API keys" > Publishable key
#            (começa com sb_publishable_...)
#
# ATENÇÃO: use a PUBLISHABLE key, nunca a "secret key" (sb_secret_...).
# A secret ignora toda a segurança do banco e só pode ficar no painel.
# A publishable é segura no app justamente porque a RLS está ligada.
#
# NUNCA commite o .env no GitHub — adicione ".env" no .gitignore.
# Depois de criar/alterar o .env, rode:  npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://tcrabrpnvxgqmxdlvwdc.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cole-aqui
